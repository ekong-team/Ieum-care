    "EvaluationResponse": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "integration-v1"
          ]
        },
        "request_id": {
          "type": "string"
        },
        "evaluation_id": {
          "type": "string"
        },
        "analysis_id": {
          "type": "string"
        },
        "plan_id": {
          "type": "string"
        },
        "criteria_version": {
          "type": "string",
          "enum": [
            "planning-review-v1"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "ready",
            "needs_input",
            "needs_revision"
          ]
        },
        "criteria_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CriterionResult"
          }
        },
        "performance_plan": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PerformanceMeasure"
          }
        },
        "budget": {
          "$ref": "#/$defs/BudgetResult"
        },
        "comparison": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "baseline_plan_id": {
                  "type": "string"
                },
                "revised_plan_id": {
                  "type": "string"
                },
                "same_scope_confirmed": {
                  "type": "boolean"
                },
                "budget_difference_krw": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "notes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "baseline_plan_id",
                "revised_plan_id",
                "same_scope_confirmed",
                "budget_difference_krw",
                "notes"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
