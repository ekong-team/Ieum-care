    "RevisionStartRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "analysis_id",
        "planning_as_of",
        "program_plan"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "analysis_id": {
          "type": "string",
          "pattern": "^2025(07|08|09|10|11|12)_(11230|32010)_(10G|20G|30G|40G|50G|60GU)$"
        },
        "planning_as_of": {
          "type": "string",
          "format": "date"
        },
        "program_plan": {
          "$ref": "#/$defs/ProgramPlan"
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "HumanDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "reviewer",
        "note"
      ],
      "properties": {
        "action": {
          "enum": [
            "provide_input",
            "record_review",
            "reject"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "program_plan": {
          "$ref": "#/$defs/ProgramPlan"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "provide_input"
              }
            }
          },
          "then": {
            "required": [
              "program_plan"
            ]
          },
          "else": {
            "not": {
              "required": [
                "program_plan"
              ]
            }
          }
        }
      ]
    }
  }
}